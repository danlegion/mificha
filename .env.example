# ─── MiFicha v0.1 — variables de entorno ───
# Copia este archivo a `.env` y completa los valores.
# Nada de este archivo se sube a git (.env está en .gitignore).

# --- LLM ---
# Clave de Gemini (AI Studio). Es la primera que se usa si está presente.
# https://aistudio.google.com → Get API Key
GEMINI_API_KEY=<redacted>
# Modelo de Gemini (default: gemini-3.5-flash-lite, verificado en free tier).
GEMINI_MODEL=
# Clave de Anthropic (alternativa). Si ninguna llave está presente, la app
# corre en MODO DEMO: explicación local determinista, sin llamadas de red.
ANTHROPIC_API_KEY=<redacted>
# Modelo a usar con Anthropic (ej.: el modelo Claude que uses en producción).
LLM_MODEL=

# --- Supabase (producción) ---
# Si están vacías, se usa SQLite local en ./data/mificha.db
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# --- OCR ---
# Proveedor de OCR para páginas escaneadas: null | azure | google
# null = no hay OCR: las páginas escaneadas solo se marcan como tales.
OCR_PROVIDER=null
# Endpoint de Azure Document Intelligence (solo si OCR_PROVIDER=azure).
AZURE_DI_ENDPOINT=
# Clave de Azure Document Intelligence (solo si OCR_PROVIDER=azure).
AZURE_DI_KEY=
# Proyecto de Google Document AI (solo si OCR_PROVIDER=google).
GOOGLE_DOCAI_PROJECT=

# --- App ---
# Clave para firmar sesiones/tokens. ¡Cámbiala en producción!
SECRET_KEY=cambia-esta-clave-en-produccion
# Vacío = SQLite local en ./data/mificha.db
DATABASE_URL=
# Vacío = ./data/originales (carpeta donde se guardan los PDFs subidos).
STORAGE_DIR=
# Puerto del servidor local.
PORT=8000
# URL pública de la app. Se usa para construir los enlaces de WhatsApp (/s/...).
# En producción pon tu dominio, ej: https://mificha.app
BASE_URL=http://localhost:8000
