# ─── MiFicha — variables de entorno ───
# Copia este archivo a `.env` y completa los valores.
# Nada de este archivo se sube a git (.env está en .gitignore, y
# .dockerignore impide que entre en la imagen Docker).
#
# Para self-hosting con Docker, solo necesitas de verdad:
#   GEMINI_API_KEY, SECRET_KEY y BASE_URL.
# Deja SUPABASE_URL vacío y la app usa SQLite en la carpeta de datos
# montada por docker-compose.yml (./mificha-data por defecto).

# --- LLM ---
# Clave de Gemini (AI Studio). Es la primera que se usa si está presente.
# https://aistudio.google.com → Get API Key
GEMINI_API_KEY=
# Modelo de Gemini (default en código: gemini-3.5-flash-lite).
GEMINI_MODEL=
# Clave de Anthropic (alternativa). Si ninguna llave está presente, la app
# corre en MODO DEMO: explicación local determinista, sin llamadas de red.
ANTHROPIC_API_KEY=
# Modelo a usar con Anthropic.
LLM_MODEL=

# --- Supabase (solo para el despliegue en la nube; vacío = SQLite local) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# --- OCR ---
# Tesseract corre dentro de la imagen Docker (español + inglés) y es el
# proveedor principal. Google Document AI es solo fallback cuando Tesseract
# no extrae texto útil, y solo si están configuradas estas dos variables.
OCR_PROVIDER=tesseract
DOCAI_PROCESSOR=
DOCAI_CREDENTIALS_JSON=
# Opcionales de OCR (defaults en código): OCR_DPI, OCR_LANGS, OCR_MAX_PAGES,
# OCR_PSM, OCR_TIMEOUT, DOCAI_TIMEOUT.

# --- App ---
# Clave para firmar sesiones/tokens. OBLIGATORIA en producción: genera una
# aleatoria, p. ej. `python3 -c "import secrets; print(secrets.token_hex(32))"`.
# Nunca uses un valor de ejemplo ni la clave por defecto del código.
SECRET_KEY=
# URL pública de la app. Se usa para construir los enlaces de WhatsApp
# (/s/...). En self-hosting privado pon tu dirección de Tailscale, p. ej.
# http://mini-pc:8000 — no hace falta un dominio público.
BASE_URL=http://localhost:8000
# Puerto del servidor (Docker Compose fija 8000).
PORT=8000
# Opcionales (defaults en código): MAX_PDF_MB=15, MAX_PDF_PAGES=30,
# SHARE_TTL_DAYS=7, UPLOAD_RATE_LIMIT_PER_HOUR=10.
