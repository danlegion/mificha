# ─── MiFicha — environment variables ───
# Copy this file to `.env` and fill in the values.
# Nothing in this file is committed to git (.env is in .gitignore, and
# .dockerignore keeps it out of the Docker image).
#
# For self-hosting with Docker, the only ones you truly need are:
#   GEMINI_API_KEY, SECRET_KEY and BASE_URL.
# Leave SUPABASE_URL empty and the app uses SQLite in the data folder
# mounted by docker-compose.yml (./mificha-data by default).

# --- LLM ---
# Which provider explains the exams: "gemini" | "anthropic" | "openai" |
# "demo" | "auto" (default: the first one with a key, in that order).
# An explicit provider without its key falls through to the next one
# with a key (with a warning in the logs), never breaking uploads.
LLM_PROVIDER=auto
# Gemini key (AI Studio). https://aistudio.google.com → Get API Key
GEMINI_API_KEY=
# Gemini model (default in code: gemini-3.5-flash-lite).
GEMINI_MODEL=
# Anthropic key (Claude). https://console.anthropic.com → API keys
ANTHROPIC_API_KEY=
# Model to use with Anthropic (default in code: claude-sonnet-5-5).
# The old name LLM_MODEL still works if you already use it.
ANTHROPIC_MODEL=
# OpenAI key (ChatGPT API — a platform key, not the ChatGPT login).
# https://platform.openai.com/api-keys → Create new secret key
OPENAI_API_KEY=
# Model to use with OpenAI (default in code: gpt-5-mini).
OPENAI_MODEL=
# If no key is present at all, the app runs in DEMO MODE: local
# deterministic explanation, no network calls.

# --- Supabase (only for the cloud deployment; empty = local SQLite) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# --- OCR ---
# Tesseract runs inside the Docker image (Spanish + English) and is the
# main provider. Google Document AI is only a fallback when Tesseract
# extracts no useful text, and only if these two variables are set.
OCR_PROVIDER=tesseract
DOCAI_PROCESSOR=
DOCAI_CREDENTIALS_JSON=
# Optional OCR settings (defaults in code): OCR_DPI, OCR_LANGS, OCR_MAX_PAGES,
# OCR_PSM, OCR_TIMEOUT, DOCAI_TIMEOUT.

# --- Single-password gate (self-hosting only, no Supabase) ---
# Set BOTH to lock the whole instance behind one username/password:
# every page (except /acceso, statics, language switch, and /s/ share
# links) requires that login, and guest upload is off. Leave
# APP_PASSWORD empty and there is no gate: the public demo and guest
# flow work as before. The password lives ONLY here (.env is git-ignored
# and kept out of the Docker image) — never paste it in chat or git.
# Rotate it by editing this file and restarting the container.
APP_USERNAME=
APP_PASSWORD=

# --- App ---
# Key for signing sessions/tokens. REQUIRED in production: generate a
# random one, e.g. `python3 -c "import secrets; print(secrets.token_hex(32))"`.
# Never use an example value or the code's default key.
SECRET_KEY=
# Public URL of the app. Used to build the WhatsApp links
# (/s/...). For private self-hosting, put your Tailscale address, e.g.
# http://mini-pc:18473 — no public domain needed.
BASE_URL=http://localhost:18473
# Server port (Docker Compose pins 18473).
PORT=18473
# Optional (defaults in code): MAX_PDF_MB=15, MAX_PDF_PAGES=30,
# SHARE_TTL_DAYS=7, UPLOAD_RATE_LIMIT_PER_HOUR=10.
