+@app.middleware("http")
+async def security_headers(request: Request, call_next):
+    """Cabeceras de endurecimiento.
+
+    Referrer-Policy garantiza que los tokens ?t= de las URLs nunca salgan
+    en el encabezado Referer hacia integraciones de terceros, presentes
+    o futuras. Hoy solo Google Fonts recibe requests cross-origin y los
+    navegadores ya solo envian el origen pelado; esto lo hace explicito
+    y permanente.
+    """
+    resp = await call_next(request)
+    resp.headers["Referrer-Policy"] = "strict-origin-when-cross-origin"
+    return resp
